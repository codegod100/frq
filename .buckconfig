[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# The prelude bundled with the buck2 binary, so the only pinned thing is
# scripts/buck2 itself.
[external_cells]
  prelude = bundled

# Both of these name the cache-enabled platform, and both are needed: the
# second registers it, the first is what actually routes toolchain-owned
# actions onto it.
[parser]
  target_platform_detector_spec = target:root//...->root//platforms:cache \
    target:prelude//...->root//platforms:cache \
    target:toolchains//...->root//platforms:cache

[build]
  execution_platforms = root//platforms:cache

[project]
  ignore = .git,android/build,.jolt-native,buck-out
