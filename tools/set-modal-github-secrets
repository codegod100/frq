#!/usr/bin/env bash
# Set the Modal credentials required by the GitHub Actions deploy workflow.
#
# Usage:
#   tools/set-modal-github-secrets
#
# The Python helper reads the Modal credentials with terminal echo disabled and
# passes them to gh via stdin. It does not use environment variables.

set -euo pipefail

if [ "$#" -ne 0 ]; then
    echo "usage: $0" >&2
    exit 2
fi

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

if ! repo="$(cd "$repo_root" && gh repo view --json nameWithOwner --jq .nameWithOwner)"; then
    echo "error: could not identify the GitHub repository for $repo_root" >&2
    exit 1
fi

exec python3 "$script_dir/set_modal_github_secrets.py" --repo "$repo"
