#!/usr/bin/env bash
# Set the test account's handle and app password as GitHub Actions secrets,
# for tests of the screens that need a signed-in account.
#
# Usage:
#   tools/set-test-account-github-secrets [--handle HANDLE] [--no-verify]
#
# The Python helper reads the app password with terminal echo disabled, signs
# in once to check it, and passes it to gh via stdin.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

if ! repo="$(cd "$repo_root" && gh repo view --json nameWithOwner --jq .nameWithOwner)"; then
    echo "error: could not identify the GitHub repository for $repo_root" >&2
    exit 1
fi

exec python3 "$script_dir/set_test_account_github_secrets.py" --repo "$repo" "$@"
