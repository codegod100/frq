(ns frq.atproto.web
  "The browser's AT Protocol transport: one XMLHttpRequest per request.

  `frq.atproto.dart` with `HttpClient` swapped for the only HTTP a page has.
  Built by hand rather than through `HttpRequest.request`, for the reason
  `frq.io.web/fetch-text!` is: that helper wants its headers as a Dart
  `Map<String,String>` and a ClojureDart map is not one, where
  `setRequestHeader` per pair needs no conversion.

  Two differences from the native client that are the browser's and not ours.

  `user-agent` is not sent: browsers reserve it and throw if told otherwise,
  where the dart:io client sends `frq`. No AT Protocol endpoint cares.

  CORS decides whether this works at all, and it is the far side's decision.
  Bluesky's own PDS answers browser clients — their app is a web app — so
  `com.atproto.server.createSession` against bsky.social is reachable. A
  self-hosted PDS that sends no `Access-Control-Allow-Origin` is not, and the
  failure arrives as a request that never happened rather than as a status
  code: the browser refuses it before it leaves. That is why the error here
  says CORS out loud rather than reporting a network fault — it is the
  likeliest cause by far, and the one the console will confirm."
  (:require ["dart:async" :as async]
            ["dart:html" :as html]
            [frq.atproto.http :as http]))

(defn ^:private ^:async fetch
  "One request, its body as a string. `body` nil is a GET.

  Resolves with the body for any status the far side actually returned,
  including a 4xx: `frq.atproto.core`'s `-parse` functions read the error JSON
  a PDS sends and turn it into the message the connect screen shows, so
  throwing on status here would replace a good message with a worse one."
  [{:keys [host path body]}]
  (let [url (str "https://" host path)
        req (html/HttpRequest.)
        done (async/Completer.)]
    (.open req (if body "POST" "GET") url)
    ;; No user-agent: the browser reserves it. `accept` and `content-type` are
    ;; ours to set and are what the PDS reads.
    (.setRequestHeader req "accept" "application/json")
    (when body
      (.setRequestHeader req "content-type" "application/json"))
    (.addEventListener req "load"
                       (fn [_]
                         (when-not (.-isCompleted done)
                           (.complete done (str (.-responseText req))))
                         nil))
    (.addEventListener req "error"
                       (fn [_]
                         (when-not (.-isCompleted done)
                           (.completeError
                            done
                            (Exception.
                             (str "Could not reach " host
                                  " — the browser refused the request,"
                                  " which for a PDS is usually CORS"))))
                         nil))
    (if body (.send req (str body)) (.send req))
    (await (.-future done))))

(defn install! []
  (http/install! {:fetch fetch}))
