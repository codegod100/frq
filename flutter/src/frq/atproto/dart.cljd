(ns frq.atproto.dart
  "The phone's AT Protocol: `frq.atproto.core` with dart:io under it.

  The mirror of `frq.atproto` on the desktop, and shorter than it by the whole
  of the HTTP — jolt hand-rolls request lines onto a TLS socket because
  mvn-http's `fetch` writes to a file and cannot POST, and `HttpClient` simply
  does it. TLS included, which is the part Android never had.

  Async all the way down, so these cannot be the same functions the desktop
  exposes even though they do the same thing. That is the reason core is split
  into `-req` and `-parse` pairs rather than shared whole: the descriptions and
  the answers are portable, and only who waits for them is not."
  (:require ["dart:convert" :as conv]
            ["dart:io" :as io]
            [frq.atproto.http :as http]))

(defonce ^:private client (io/HttpClient.))

(defn ^:async fetch
  "Perform one `-req` descriptor and return the body as a string.

  `body` nil is a GET. Always https: every host core names is an AT Protocol
  service, and there is no plaintext variant of any of them."
  [{:keys [host path body]}]
  ;; Uri.parse of a whole URL rather than Uri.https of host and path: a
  ;; resolveHandle path carries its query string, and Uri.https would escape
  ;; the ? into the path.
  (let [uri (Uri.parse (str "https://" host path))
        ^io/HttpClientRequest req (await (if body
                                          (.postUrl ^io/HttpClient client uri)
                                          (.getUrl ^io/HttpClient client uri)))]
    (.set (.-headers req) "user-agent" "frq")
    (.set (.-headers req) "accept" "application/json")
    (when body
      (.set (.-headers req) "content-type" "application/json")
      (.write req body))
    (let [^io/HttpClientResponse resp (await (.close req))]
      (await (.join (.transform resp (.-decoder conv/utf8)))))))

(defn install!
  "Register the dart:io transport. The three functions that used to live below
  this are `frq.atproto.http`'s now: they were `frq.atproto.core`'s `-req` and
  `-parse` with an await between them and nothing of dart:io in them, so a
  second copy under the browser backend would have been a second answer to
  what a handle resolves to."
  []
  (http/install! {:fetch fetch}))
