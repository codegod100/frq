(ns frq.net.dart
  "An IRC socket over dart:io. The thing the jolt APK could never have.

  `frq.irc` reaches OpenSSL through the dynamic loader for TLS, and Android
  ships no public libssl — so on the phone `:6697` was unreachable, sign-in was
  desktop-only, and the connect screen fell back to the plain `:6667` listener
  on its own. `SecureSocket` is in the Dart runtime. There is nothing to load
  and nothing to find.

  The shape is different from the desktop's and deliberately so. jolt has one
  future blocking on a read, which also has to flush the outbox because the
  reader owns the connection; Dart has an event loop, so a socket is a `Stream`
  and a write is a write. No thread, no outbox, no poll interval.

  What comes out is `frq.irc.parse/parse-line`'s maps — the same parser the
  desktop runs, out of common/."
  (:require ["dart:convert" :as conv]
            ["dart:developer" :as dev]
            ["dart:io" :as io]
            [frq.debug :as debug]
            [frq.irc.parse :as parse]))

;; Whether to log every line in and out, under the name `frq.wire`.
;;
;; On by default because the questions it answers are the ones a client cannot
;; answer any other way: what a tag looked like when it left, and whether the
;; server sent it back. A field on a parsed message says what we made of a
;; line; only the line says what arrived.
;;
;; `dart:developer` rather than stdout, because stdout is nowhere: `print` in
;; a compiled bundle writes to a `*out*` nothing is holding. `logcat` picks
;; this up on a phone, which is what it is for.
;;
;; It does not reach a terminal under `just flutter-desktop`, though — that
;; recipe launches the bundle itself, and `dev/log` goes to the VM service,
;; not to the process's output. This comment used to claim otherwise, and a
;; session spent looking for the wire log on the desktop is how that was
;; found out. `frq.debug` is the way to see it there: `FRQ_JOT` names a file
;; and every line lands in it.
;;
;; A comment rather than a docstring because `defonce` takes none: it is
;; `(defonce name expr)` and nothing else, and the extra form is an arity
;; error the compiler reports against the namespace rather than the line.
(defonce wire-log? (atom true))

(defn- wire! [direction line]
  (when @wire-log?
    (dev/log (str direction " " line) .name "frq.wire")
    ;; And to the file when one is asked for, which is the only way to read
    ;; this on a desktop build. Redacted the way the desktop's own trace is:
    ;; a line beginning `AUTHENTICATE` carries the credential itself, and a
    ;; log is something you paste into a bug report.
    (when (debug/on?)
      (debug/jot! direction " "
                  (if (.startsWith (str line) "AUTHENTICATE ")
                    "AUTHENTICATE <redacted>"
                    line)))))

(defn ^:async connect!
  "Open a connection and start reading it.

  `on-msg` is called with a parsed map per line; `on-close` with a reason, or
  nil where the peer simply went away. Returns the socket, which `send-line!`
  and `close!` take."
  [{:keys [host port tls? on-msg on-close]}]
  (let [buffer (atom "")
        sock (await (if tls?
                      (io/SecureSocket.connect host port)
                      (io/Socket.connect host port)))]
    ;; Lines are cut here rather than by a LineSplitter in the chain. Two
    ;; transforms deep, cljd hands the splitter a CastStream<String, dynamic>
    ;; where it wants a Stream<String>, and it throws at the first byte — the
    ;; generic is lost through the dynamic call. Buffering the decoded chunks
    ;; is a few lines and has no type to lose.
    ;;
    ;; \r\n or \n: IRC says the former and servers send both.
    (-> sock
        (.transform (.-decoder conv/utf8))
        (.listen (fn [chunk]
                   ;; Split rather than a LineSplitter in the chain: two
                   ;; transforms deep, cljd hands the splitter a
                   ;; CastStream<String, dynamic> where it wants a
                   ;; Stream<String> and it throws at the first byte — the
                   ;; generic is lost through the dynamic call.
                   ;;
                   ;; The tail after the last newline is a partial line and
                   ;; goes back in the buffer. A chunk boundary falls wherever
                   ;; TCP puts it, which is not where IRC put its lines.
                   (let [parts (.split (str @buffer chunk) "\n")
                         whole (butlast parts)]
                     (reset! buffer (str (last parts)))
                     (doseq [raw whole]
                       (let [line (.trim (str raw))]
                         (when (and on-msg (pos? (count line)))
                           (wire! "<" line)
                           (let [m (parse/parse-line line)]
                             ;; PING is answered here rather than upstairs: a
                             ;; client that leaves it to the reducer is one
                             ;; queue away from a timeout, and nothing about
                             ;; the answer is a decision.
                             (when (= "PING" (:command m))
                               ;; Logged like any other write even though it is
                               ;; keepalive noise: a log that quietly omits a
                               ;; line is worse than a long one.
                               (let [pong (str "PONG :" (first (:params m)))]
                                 (wire! ">" pong)
                                 (.write sock (str pong "\r\n"))))
                             (on-msg m)))))))
                 .onDone (fn [] (when on-close (on-close nil)))
                 .onError (fn [e _] (when on-close (on-close (str e))))
                 .cancelOnError true))
    sock))

(defn send-line! [^io/Socket sock line]
  (wire! ">" line)
  (.write sock (str line "\r\n")))

(defn close! [^io/Socket sock]
  (try (.destroy sock) (catch Exception _ nil)))
