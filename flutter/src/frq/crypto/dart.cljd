(ns frq.crypto.dart
  "The phone's answers to `frq.crypto`.

  Android ships no libcrypto a process may link, so where the desktop reaches
  OpenSSL through the loader this brings its own: `package:ed25519_edwards`
  for the signatures and `package:crypto` for the digest, both pure Dart and
  both synchronous — which matters, because a signature is minted in the
  middle of sending a reaction and there is nothing there to await on.

  pointycastle would have been the obvious choice and does not implement
  Ed25519 at all; it carries the object identifier and nothing behind it."
  (:require ["dart:math" :as math]
            ["dart:typed_data" :as td]
            ["package:crypto/crypto.dart" :as c]
            ["package:ed25519_edwards/ed25519_edwards.dart" :as ed]
            [frq.crypto :as crypto]))

(defonce ^:private rng (math/Random.secure))
(defonce ^:private priv (atom nil))

(defn- u8
  "A byte sequence as the Uint8List these libraries take.

  Built rather than cast: `frq.msgsig` passes vectors and lazy seqs, because
  those are the shapes both compilers agree on, and a PersistentVector is not
  a List<int>."
  [bs]
  (let [v (vec bs)
        n (count v)
        out (td/Uint8List. n)]
    (dotimes [i n]
      (aset out i (bit-and (int (nth v i)) 0xff)))
    out))

(defn- random-bytes [n]
  (let [out (td/Uint8List. n)]
    (dotimes [i n] (aset out i (.nextInt ^math/Random rng 256)))
    (vec out)))

(defn- sha256 [bs]
  (vec (.-bytes (.convert c/sha256 (u8 bs)))))

(defn- forget! []
  (reset! priv nil)
  nil)

(defn- generate! [seed]
  (try
    (let [k (ed/newKeyFromSeed (u8 seed))]
      (reset! priv k)
      (vec (.-bytes (ed/public k))))
    (catch Object _ nil)))

(defn- sign [bs]
  (when-let [k @priv]
    (try (vec (ed/sign k (u8 bs)))
         (catch Object _ nil))))

(defn install! []
  (crypto/install!
   {:random-bytes random-bytes
    :sha256 sha256
    :ed25519-generate! generate!
    :ed25519-sign sign
    :ed25519-forget! forget!}))
