(ns frq.avatars.dart
  "Profile pictures for the Flutter half, as URLs rather than as files.

  `frq.avatars` on the desktop downloads the PNG to `~/.cache/frq/avatars` and
  hands the screens a path, because the tree backend paints from a decoded file
  and nothing under jolt fetches an image for it. Flutter already has that
  layer: `NetworkImage` fetches, decodes and keeps the result in the image
  cache, keyed by URL, for every row that names it. So the only thing missing
  here is the URL, and the whole disk half of the desktop's version would be a
  download written so Flutter could read it back and fetch nothing.

  What that costs is the *between runs* half of the desktop's cache: the image
  cache is memory, so a relaunch asks the CDN again. One 128-pixel PNG per
  person in a conversation, against adding a binary download to `frq.io` — a
  seam that so far has needed only strings.

  One lookup per person however many lines they write, and none at all for a
  guest: `frq.profile/actor` answers nil for a nick that is not handle-shaped,
  and nil never reaches here."
  (:require ["dart:async" :as async]
            [frq.atproto.dart :as atproto]
            [frq.profile :as profile]))

;; actor -> {:status :loading | :ready | :failed, :url when there is one}.
;;
;; Deliberately not `frq.profile`'s cache, though both are filled from the same
;; `getProfile` body: that one is filled when someone *opens* a profile, and
;; this one when a message arrives, which is every sender in the room. Sharing
;; it would make opening a profile a no-op that shows the stale bio a message
;; fetched an hour ago.
(defonce ^:private cache (atom {}))

(defn url
  "This person's picture, or nil while it is on its way and after it failed.
  Nil is also the honest answer for someone with no picture at all — the
  screens draw the initial for all three."
  [actor]
  (:url (get @cache (str (or actor "")))))

(defn fetch!
  "Ensure this person's avatar URL is known, in the background. Returns without
  waiting; `url` answers for it afterwards, and `on-change` says when that
  answer has changed."
  [actor on-change]
  (let [a (str (or actor ""))]
    (when (and (seq a) (not (contains? @cache a)))
      (swap! cache assoc a {:status :loading})
      (.then ^async/Future (atproto/fetch (profile/profile-req a))
             (fn [body]
               (swap! cache assoc a {:status :ready :url (profile/avatar-url body)})
               (on-change)
               nil)
             ;; A directory that does not answer is a face that stays an
             ;; initial, not a retry loop: the entry stays in the map, so this
             ;; person is asked about once per run either way.
             .onError (fn [_ _]
                        (swap! cache assoc a {:status :failed})
                        (on-change)
                        nil)))))
