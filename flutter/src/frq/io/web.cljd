(ns frq.io.web
  "The browser's answers to `frq.io`, over dart:html.

  The third backend, beside `frq.io.jolt` on the desktop and `frq.io.dart`
  under Flutter's Android and Linux targets — and the one that shows what the
  seam was for. Everything the other two get from a filesystem, this one does
  not have: a browser has no directory, no path, no mode bits and no uid to
  keep a file from. What it has is an origin and a key-value store that
  belongs to it.

  So the paths `frq.store` and `frq.oauth` hand over are not opened here, they
  are *spelled*: `config-dir` answers with a name that is a prefix and nothing
  else, and every file under it is one localStorage key. Nothing in `common/`
  can tell the difference, because nothing in `common/` was ever allowed to
  ask for more than `slurp`, `spit` and `list-dir`.

  Compiled only for the web, and only because nothing else requires it:
  `clojure -M:cljd compile` walks out from one entry namespace, so this file
  reaches the build through `frq.main-web` and is absent from the APK and the
  Linux bundle — which is what keeps `dart:html` out of two targets that have
  no such library.

  dart:html rather than package:web and dart:js_interop: it is in the SDK, so
  it adds nothing to pubspec.yaml, and what is wanted here is localStorage and
  XMLHttpRequest rather than anything that needs the newer binding. It is
  deprecated, and the day it goes this file is where the change lands."
  (:require ["dart:convert" :as conv]
            ["dart:html" :as html]
            [frq.io :as fio]))

(defonce ^:private uptime
  ;; Dart has no monotonic clock as such; a Stopwatch started at load is one.
  ;; The same trick `frq.io.dart` plays, and portable because Stopwatch is in
  ;; the core library rather than in dart:io.
  (doto (Stopwatch.) (.start)))

(def ^:private root
  "What `config-dir` answers. A prefix rather than a directory: there is no
  such place, and the only thing the callers do with it is join a filename
  onto it. Leading slash so a path built from it reads like the ones the other
  two backends hand out, which matters only when one ends up in a log."
  "/frq")

(defn- store
  "localStorage, which is a `Map<String,String>` scoped to this origin.

  Fetched per call rather than held in a `defonce`: a browser with site data
  blocked throws on the *access*, not at load, and a backend that died while
  being installed would take the whole app with it. Here the throw is caught
  by whichever operation asked, and that operation alone answers nil."
  ^html/Storage []
  (.-localStorage html/window))

;; Files are keys, and the prefix is what makes them findable: `list-dir` has
;; nothing but the key space to search, so a file has to carry its own path.
(def ^:private file-prefix "frq:file:")

(defn- k [path] (str file-prefix path))

;; Storage is a Dart Map, and a Dart Map is read with `get` and written with
;; the `[]=` operator — never with `aget`/`aset`, which compile to
;; `(x as List)[k as int]` and throw a TypeError on anything that is not a
;; List. Every catch below duly swallowed it, so localStorage quietly did
;; nothing at all: reads answered nil, writes answered false, and the app
;; looked like it simply had no saved state.
;;
;; `Object` and not `Exception` throughout this file: a browser throws Errors
;; where dart:io throws Exceptions -- `UnsupportedError` for a library that is
;; not there, and a DOM failure need not be an Exception either. In Dart an
;; Error is not an Exception, so `on Exception catch` lets it straight through,
;; and every catch below exists precisely so that the operation answers instead
;; of taking its caller down.
(defn- slurp* [path]
  (try
    (let [^html/Storage s (store) key (k path)]
      (when (.containsKey s key) (get s key)))
    (catch Object _ nil)))

(defn- spit* [path s]
  (try
    (. ^html/Storage (store) "[]=" (k path) (str s))
    true
    (catch Object _ false)))

(defn- file-keys
  "Every stored path, as paths rather than as keys."
  []
  (try
    (into [] (comp (map str)
                   (filter (fn [^String key] (.startsWith key file-prefix)))
                   (map (fn [^String key] (str (.substring key (count file-prefix))))))
          (.-keys ^html/Storage (store)))
    (catch Object _ [])))

(defn- list-dir*
  "The paths directly under `path`.

  Directly, not recursively: `frq.store` reads a directory expecting the files
  in it, and a nested key handed back whole would be opened as a file and read
  as nothing. So a key that goes deeper contributes its first segment, once —
  which is the directory the other two backends would have shown."
  [path]
  (let [^String pre (str path (when-not (.endsWith (str path) "/") "/"))]
    (into []
          (comp (filter (fn [^String p] (.startsWith p pre)))
                (map (fn [^String p]
                       (let [^String rest (str (.substring p (count pre)))
                             cut (.indexOf rest "/")]
                         (if (neg? cut) p (str pre (.substring rest 0 cut))))))
                (distinct))
          (file-keys))))

(defn- fetch-text!
  "`frq.io/fetch-text!` over XMLHttpRequest.

  Built up by hand rather than through `HttpRequest.request`, which wants its
  headers as a Dart `Map<String,String>` — and a ClojureDart map is not one.
  `setRequestHeader` per pair says the same thing with no conversion, and the
  callbacks are already the shape the seam asks for, so there is no Future to
  bridge either.

  No user-agent: the browser sets it and refuses to be told otherwise, where
  `frq.io.dart` sends `frq`. That is the one header the web half cannot honour.

  What it cannot do anything about is the origin. Every request from here is
  cross-origin and subject to CORS, so a server that does not send the headers
  is a request that fails before it is made, no matter what this sends."
  [url headers on-done]
  (try
    (let [req (html/HttpRequest.)]
      (.open req "GET" (str url))
      (doseq [[hk hv] headers]
        (try (.setRequestHeader req (str hk) (str hv))
             ;; A header the browser reserves throws rather than being ignored,
             ;; and one refused header should not lose the whole request.
             (catch Object _ nil)))
      (.addEventListener req "load"
                         (fn [_]
                           (on-done (when (= 200 (.-status req)) (.-responseText req)))
                           nil))
      (.addEventListener req "error" (fn [_] (on-done nil) nil))
      (.addEventListener req "abort" (fn [_] (on-done nil) nil))
      (.send req))
    (catch Object _ (on-done nil)))
  nil)

(defn- utf8-string
  "Byte values back to the text they spell.

  Typed `List<int>` and not a cljd vector, for `frq.io.dart`'s reason: Dart's
  `utf8.decode` wants a real one, and a PersistentVector is not."
  [bs]
  (let [n (count bs)
        ^#/(List int) ary (.filled List n 0)]
    (loop [s (seq bs) i 0]
      (if (nil? s)
        (.decode conv/utf8 ary)
        (do (aset ary i (first s))
            (recur (next s) (inc i)))))))

(defn install!
  "Install the browser's answers. No argument and nothing to await, unlike
  `frq.io.dart/install!` — which is the whole reason the web entry point is a
  separate one: there is no storage directory to wait for, so `frq.main-web`
  can install before its first frame rather than after a Future."
  []
  (fio/install!
   {;; A browser has no environment. nil rather than a throw: every caller of
    ;; `getenv` in `common/` already treats a missing variable as ordinary —
    ;; it is how the desktop says a thing was not configured.
    :getenv               (fn [_] nil)
    :fetch-text!          fetch-text!
    ;; `_blank`, and the reader's own browser is already the browser: the
    ;; OAuth handoff that `frq.io.dart` sends to an external application is
    ;; simply another tab here. Popup blockers can refuse it, which is why the
    ;; seam lets this answer false — the OAuth screen shows the URL to open by
    ;; hand.
    :open-url!            (fn [url]
                            (try
                              (some? (.open html/window (str url) "_blank"))
                              (catch Object _ false)))
    :config-dir           (fn [] root)
    :file-exists?         (fn [p] (some? (slurp* p)))
    ;; A directory exists here exactly when something is under it. There is no
    ;; empty directory to find, because `mkdirs!` writes nothing.
    :directory?           (fn [p] (boolean (seq (list-dir* p))))
    :list-dir             list-dir*
    ;; Nothing to make. A key holds its whole path, so the parent of a file is
    ;; created by writing the file, and asking for it in advance is a no-op
    ;; that has to answer truthfully anyway.
    :mkdirs!              (fn [_] true)
    :delete-file!         (fn [p]
                            (try (.remove ^html/Storage (store) (k p)) true
                                 (catch Object _ false)))
    :slurp                slurp*
    :spit                 spit*
    ;; localStorage is already origin-private: no other site can read it, and
    ;; there is no second uid on this machine that reaches it through the
    ;; browser. So the private write is the ordinary write, the way it is on
    ;; Android — and unlike Android, what it is private *from* is worth saying
    ;; plainly: not from anyone with the reader's disk, only from other pages.
    :write-private-file!  spit*
    ;; Not answerable, and nil is the seam's word for that. A save here would
    ;; mean an anchor with a download attribute over a blob, and what the
    ;; caller has is a path into a media cache that is itself a localStorage
    ;; key holding text — so there is nothing to make a blob from until
    ;; `frq.media` has a web half. The caller shows the answer, and the answer
    ;; is that it did not land anywhere.
    :save-to-downloads!   (fn [_ _] nil)
    :utf8-bytes           (fn [s] (vec (.encode conv/utf8 (str s))))
    :utf8-string          utf8-string
    :wall-nanos           (fn [] (* 1000 (.-microsecondsSinceEpoch (DateTime/now))))
    :mono-nanos           (fn [] (* 1000 (.-inMicroseconds (.-elapsed ^Stopwatch uptime))))
    ;; Dart carries the zone in the runtime on the web too -- it comes from the
    ;; browser rather than from /etc/localtime, which is the case `frq.clock`
    ;; was already written not to care about.
    :local-offset-seconds (fn [secs]
                            (-> (DateTime/fromMillisecondsSinceEpoch (* 1000 secs))
                                (.-timeZoneOffset)
                                (.-inSeconds)))}))
