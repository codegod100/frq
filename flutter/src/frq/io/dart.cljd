(ns frq.io.dart
  "Flutter's answers to `frq.io`, over dart:io.

  `dart:io` has TLS, sockets and a filesystem in the runtime, which is the
  reason the seam exists at all: this used to be the half of frq where login
  did not work, because the runtime under it reached OpenSSL through the
  dynamic loader and Android has no public libssl.

  This cannot install itself at load time: the app's storage directory arrives
  from path_provider as a Future, so the Flutter entry point awaits it and
  calls `install!` with the answer before it runs anything else.

  Two Flutter targets share this file, not one: `just apk` and
  `just flutter-desktop` compile the same ClojureDart, so \"the phone\" is no
  longer a safe assumption to bury in an implementation here. Where the answer
  genuinely differs by platform it is asked rather than assumed — see
  `write-private-file!`, which is the one place the difference has teeth."
  (:require ["dart:convert" :as conv]
            ["dart:io" :as io]
            ["package:url_launcher/url_launcher.dart" :as launcher]
            [frq.io :as fio]))

(defonce ^:private uptime
  ;; Dart has no monotonic clock as such; a Stopwatch started at load is one.
  (doto (Stopwatch.) (.start)))

(defn- slurp* [path]
  (try
    (let [f (io/File. path)]
      (when (.existsSync f) (.readAsStringSync f)))
    (catch Exception _ nil)))

(defn- spit* [path s]
  (try
    (.writeAsStringSync (io/File. path) s)
    true
    (catch Exception _ false)))

(defn- write-private-file!
  "600 where that means something, an ordinary write where it does not.

  On Android the app's own storage is already private to the app — there is no
  other uid that can read it — so mode 600 has nobody to exclude, and this is
  the ordinary write it always was. On a Linux desktop, where this same backend
  now paints the Flutter window, there very much is another uid: the file lands
  under the XDG data directory with the process umask, which is world-readable
  on most systems, and what it holds is a broker token.

  So the desktop branch does what `frq.io.jolt` does and in the same order —
  create, restrict, *then* write — so the token is never on disk readable even
  for an instant. Dart has no chmod of its own, which is why this is a process
  and not a call.

  This is the seam earning its keep. `frq.io` names the intent rather than the
  mechanism, so one `write-private-file!` can mean three different things and
  no caller has to know which."
  [path s]
  (if (.-isAndroid io/Platform)
    (spit* path s)
    (try
      (let [f (io/File. path)]
        (when-not (.existsSync f) (.createSync f .recursive true))
        (io/Process.runSync "chmod" ["600" path])
        (.writeAsStringSync f s)
        true)
      (catch Exception _ false))))

(defn- dir-at
  "`p` if there is a directory there, else nil."
  [p]
  (when (and (seq (str p)) (.existsSync (io/Directory. p))) p))

(defn- downloads-dir
  "Where a save lands, asked rather than assumed — this file compiles for a
  Linux desktop and for Android, and they do not agree.

  The desktop has XDG: `XDG_DOWNLOAD_DIR` where the user-dirs file names one,
  otherwise `~/Downloads`, created if that is all that is missing. Android has
  the shared `Download` store, which is writable without a permission on the
  devices that still let an app see it at all, and where it is not, the app's
  own storage is the honest answer — it is somewhere, and the caller shows
  where."
  [fallback]
  (if (.-isAndroid io/Platform)
    (or (dir-at "/storage/emulated/0/Download")
        (dir-at "/sdcard/Download")
        fallback)
    (let [env (.-environment io/Platform)
          xdg (get env "XDG_DOWNLOAD_DIR")
          home (get env "HOME")
          dir (cond (seq (str xdg)) (str xdg)
                    (seq (str home)) (str home "/Downloads")
                    :else nil)]
      (when dir
        (when-not (.existsSync (io/Directory. dir))
          (try (.createSync (io/Directory. dir) .recursive true) (catch Exception _ nil))))
      (or (dir-at dir) (dir-at (get env "HOME")) fallback))))

(defn- free-path
  "`dir/name`, or the same with `-1`, `-2`… before the extension until it
  names a file that is not there. A save never writes over one."
  [dir name]
  (let [m (re-find #"^(.+)(\.[A-Za-z0-9]+)$" name)
        stem (or (second m) name)
        ext (or (nth m 2 nil) "")]
    (loop [n 0]
      (let [p (str dir "/" stem (when (pos? n) (str "-" n)) ext)]
        (cond
          (not (.existsSync (io/File. p))) p
          (> n 99) nil
          :else (recur (inc n)))))))

(defn- save-to-downloads!
  "`copySync` and not a read-then-write: what is copied is a PNG, and the
  seam's `spit` takes a string."
  [fallback path filename]
  (try
    (when-let [dir (downloads-dir fallback)]
      (when-let [dest (free-path dir (or filename "picture.png"))]
        (.copySync (io/File. path) dest)
        (when (.existsSync (io/File. dest)) dest)))
    (catch Exception _ nil)))

(defn- local-offset-seconds
  "Dart carries the zone in the runtime; no TZ, no /etc/localtime, no getprop.
  The offset is per-instant, which is what the caller wants."
  [secs]
  (-> (DateTime/fromMillisecondsSinceEpoch (* 1000 secs))
      (.-timeZoneOffset)
      (.-inSeconds)))

(defn- utf8-string
  "Byte values back to the text they spell.

  The list is built typed rather than handed over as a cljd vector: Dart's
  `utf8.decode` wants a real `List<int>`, and a PersistentVector is not one —
  the same shape of mistake as the CastStream in `frq.net.dart`, where a
  generic lost through a dynamic call only shows up at runtime. `(.filled
  List n 0)` is how cljd.core itself makes one."
  [bs]
  (let [n (count bs)
        ^#/(List int) ary (.filled List n 0)]
    (loop [s (seq bs) i 0]
      (if (nil? s)
        (.decode conv/utf8 ary)
        (do (aset ary i (first s))
            (recur (next s) (inc i)))))))

(defonce ^:private http (io/HttpClient.))

(defn ^:async ^:private get-text!
  "One GET, its body as a string — nil for anything but a 200, and nil for a
  request that never got there."
  [url headers]
  (try
    (let [^io/HttpClientRequest req (await (.getUrl ^io/HttpClient http
                                                    (Uri.parse (str url))))]
      (.set (.-headers req) "user-agent" "frq")
      (doseq [[k v] headers] (.set (.-headers req) (str k) (str v)))
      (let [^io/HttpClientResponse resp (await (.close req))]
        (if (= 200 (.-statusCode resp))
          (await (.join (.transform resp (.-decoder conv/utf8))))
          ;; Drained, or `HttpClient` holds the connection open and hands it
          ;; back out — the same rule `frq.media.dart` learned.
          (do (await (.drain resp)) nil))))
    (catch Exception _ nil)))

(defn ^:async ^:private fetch-text!
  "`frq.io/fetch-text!` over dart:io.

  Async rather than a `.then` on what `get-text!` returns: cljd sees that
  return as dynamic and says so, and a call it cannot resolve is one that
  fails at run time rather than at the compiler. The Future this returns is
  nobody's to wait on — `on-done` is where the answer goes, which is the whole
  shape of the seam."
  [url headers on-done]
  (on-done (await (get-text! url headers)))
  nil)

(defn install!
  "`dir` is the app's storage directory, already awaited from path_provider."
  [dir]
  (fio/install!
   {:getenv               (fn [n] (get (.-environment io/Platform) n))
    :fetch-text!          fetch-text!
    ;; Android picks the activity: whatever answers an https VIEW intent,
    ;; which is the browser the reader already uses and is already signed in
    ;; to. `externalApplication` and not an in-app web view on purpose — a
    ;; login the app could see inside is the thing OAuth exists to avoid.
    :open-url!            (fn [url]
                            (launcher/launchUrl
                             (Uri.parse (str url))
                             .mode launcher/LaunchMode.externalApplication)
                            true)
    :config-dir           (fn [] dir)
    :file-exists?         (fn [p] (.existsSync (io/File. p)))
    :directory?           (fn [p] (.existsSync (io/Directory. p)))
    :list-dir             (fn [p] (mapv #(.-path ^io/FileSystemEntity %) (.listSync (io/Directory. p))))
    :mkdirs!              (fn [p] (.createSync (io/Directory. p) .recursive true))
    :delete-file!         (fn [p] (.deleteSync (io/File. p)))
    :slurp                slurp*
    :spit                 spit*
    :write-private-file!  write-private-file!
    :save-to-downloads!   (fn [p f] (save-to-downloads! dir p f))
    :utf8-bytes           (fn [s] (vec (.encode conv/utf8 (str s))))
    :utf8-string          utf8-string
    :wall-nanos           (fn [] (* 1000 (.-microsecondsSinceEpoch (DateTime/now))))
    :mono-nanos           (fn [] (* 1000 (.-inMicroseconds (.-elapsed ^Stopwatch uptime))))
    :local-offset-seconds local-offset-seconds}))
