(ns frq.main
  "The Flutter entry point: what `frq.cosmic` is to the jolt half.

  Two jobs, and the first one is why `frq.io.dart` cannot install itself the
  way `frq.io.jolt` does: the app's storage directory arrives from
  path_provider as a Future, so `main` is async, awaits it, and installs the
  host before a widget is built. Everything under ../common asks `frq.io` for
  the filesystem, so nothing shared can run until that has happened.

  `ensureInitialized` first, and not as a formality: path_provider is a
  platform channel, and a channel used before the binding exists throws.

  The screens themselves are not written. `frq.app` is 1,834 lines of hiccup
  over glimmer's widget tags, and glimmer is not here — Flutter brings its own
  reconciler, so those screens are a rewrite against cljd.flutter rather than a
  port. What this paints is the proof the shared half is alive under a second
  compiler: the clock and the saved session, read through exactly the
  namespaces the desktop reads them through."
  (:require ["package:flutter/material.dart" :as m]
            ["package:path_provider/path_provider.dart" :as pp]
            [cljd.flutter :as f]
            [frq.hiccup :as h]
            [frq.theme :as t]
            [frq.io.dart :as host]
            [frq.net.dart :as net]
            [frq.atproto.dart :as atproto]
            [frq.clock :as clock]
            [frq.store :as store]
            [frq.actions :as actions]
            [frq.cells :as cells]
            [frq.screens.connect :as connect]))

(defonce ^:private lines (atom []))
(defonce ^:private conn (atom nil))
(defonce ^:private status (atom "Not connected"))

(defn- note! [m]
  (swap! lines (fn [v] (vec (take-last 8 (conj v m))))))

(defn ^:async connect!
  "What `frq.actions/connect!` is on the phone.

  The desktop's is `frq.state/connect!` — jolt's TLS, SASL, a reader thread.
  This is the dart:io one, and it reads the same cells the screen wrote: the
  host, the port and the TLS tick are `frq.cells`, filled in by the entry and
  the checkbutton on screen.

  Guest registration only. SASL wants `frq.msgsig`, which is not portable
  yet — so `frq.actions` answering a name it cannot fully honour is the point
  of that seam: the screen renders and the button works, and what is behind it
  grows."
  []
  (reset! cells/connecting? true)
  (reset! cells/error nil)
  (reset! status (str "Connecting to " @cells/form-host "…"))
  (reset! lines [])
  (try
    (let [sock (await (net/connect!
                       {:host @cells/form-host
                        ;; The cell is a string, because it is what an :entry holds.
                        :port (or (parse-long (str @cells/form-port)) 6697)
                        :tls? (boolean @cells/form-tls?)
                        :on-msg (fn [m]
                                  (note! m)
                                  (when (= "001" (:command m))
                                    (reset! cells/connecting? false)
                                    (reset! status
                                            (str "Connected as " @cells/form-nick))))
                        :on-close (fn [why]
                                    (reset! cells/connecting? false)
                                    (reset! status "Not connected")
                                    (when why (reset! cells/error why)))}))]
      (reset! conn sock)
      (net/send-line! sock (str "NICK " @cells/form-nick))
      (net/send-line! sock (str "USER " @cells/form-nick " 0 * :frq")))
    (catch Exception e
      (reset! cells/connecting? false)
      (reset! status "Not connected")
      (reset! cells/error (str e)))))

(defn- disconnect! []
  (when-let [c @conn] (net/close! c))
  (reset! conn nil)
  (reset! cells/connecting? false)
  (reset! status "Not connected"))

(defonce ^:private handle (atom "nandi-test.bsky.social"))
(defonce ^:private identity-out (atom nil))

(defn ^:async resolve-identity! []
  (reset! identity-out ["resolving…"])
  (try
    (let [h @handle
          did (await (atproto/resolve-handle h))
          pds (await (atproto/pds-endpoint did))]
      (reset! identity-out [(str "did  " did) (str "pds  " pds)]))
    (catch Exception e
      (reset! identity-out [(str "failed: " e)]))))

(defn- screen
  "The phone's panels, in glimmer's tags.

  NOT `frq.screens.connect` yet, and the reason is worth writing down rather
  than leaving as a TODO: the extraction is done and the desktop renders the
  shared file, but rendering it here paints nothing at all — no exception,
  nothing in logcat, and the sibling widgets in the same `children` vector
  disappear with it, which is what a Dart `Error` thrown while that vector is
  being built looks like. `(catch Object ...)` around it did not surface one
  either, so the failure is not where it appears to be.

  What is already proven: `frq.cells` compiles under both compilers and holds
  its values here — a probe read `cells/status` as \"Not connected\" and
  `cells/form-nick` as \"frq-guest\" on the device. So the seam is sound and
  what is left is one cljd-shaped bug between it and the screen."
  []
  [:page {:max-width 520}
   [:title {:label "frq"}]
   [:dim-label {:label "Painted by frq.hiccup in COSMIC's own theme."}]
   [:card {}
    [:title-2 {:label "Connection"}]
    [:label {:label @status}]
    [:hbox {:spacing 8}
     [:button {:label "Connect" :kind :primary :on-click #(connect!)}]
     [:button {:label "Disconnect" :destructive true :on-click #(disconnect!)}]]]
   [:card {}
    [:title-2 {:label "What the server said"}]
    (if (empty? @lines)
      [:dim-label {:label "nothing yet"}]
      (for [[i m] (map-indexed vector @lines)]
        [:label {:key i
                 :label (str (:command m)
                             (when-let [p (seq (:params m))]
                               (str "  " (last p))))}]))]
   [:card {}
    [:title-2 {:label "Identity"}]
    [:entry {:key :handle
             :text @handle
             :placeholder "alice.bsky.social"
             :on-change #(reset! handle %)}]
    [:button {:label "Resolve" :kind :primary :on-click #(resolve-identity!)}]
    (when-let [out @identity-out]
      (for [[i line] (map-indexed vector out)]
        [:label {:key i :label line}]))]
   [:card {}
    [:title-2 {:label "Shared with the desktop"}]
    [:label {:label (str "clock  " (clock/clock-time (clock/now-ms)))}]
    [:label {:label (str "cells  " @cells/form-nick " @ " @cells/form-host
                         ":" @cells/form-port)}]
    [:dim-label {:label "frq.cells, compiled by both."}]]])

(defn ^:async main []
  (m/WidgetsFlutterBinding.ensureInitialized)
  (let [dir (.-path (await (pp/getApplicationSupportDirectory)))]
    (host/install! dir)
    ;; What the shared screen calls. The desktop installs frq.state's
    ;; reducers here; this installs the phone's.
    (actions/install! {:connect! connect! :disconnect! disconnect!})
    (f/run
      (m/MaterialApp .title "frq" .theme (t/app-theme))
      .home
      (m/Scaffold .appBar (m/AppBar .title (m/Text "frq")))
      .body
      (f/widget
       :let [c-status cells/status
             c-error cells/error
             c-connecting cells/connecting?
             c-mode cells/auth-mode
             c-handle cells/form-handle
             c-nick cells/form-nick
             c-host cells/form-host
             c-port cells/form-port
             c-tls cells/form-tls?
             c-apppw cells/form-app-password
             c-broker cells/broker-token
             c-login cells/login-url]
       :watch [st c-status er c-error cn c-connecting am c-mode
               fh c-handle nk c-nick hs c-host pt c-port tl c-tls
               ap c-apppw bt c-broker lu c-login ls lines]
       (m/SingleChildScrollView
        ;; frq.app's own connect screen, out of common/ — the same file the
        ;; desktop renders, painted by frq.hiccup in COSMIC's theme.
        .child (h/render [connect/connect-screen]))))))
