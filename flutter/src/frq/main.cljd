(ns frq.main
  "The Flutter entry point: what `frq.cosmic` is to the jolt half.

  Two jobs, and the first one is why `frq.io.dart` cannot install itself the
  way `frq.io.jolt` does: the app's storage directory arrives from
  path_provider as a Future, so `main` is async, awaits it, and installs the
  host before a widget is built. Everything under ../common asks `frq.io` for
  the filesystem, so nothing shared can run until that has happened.

  `ensureInitialized` first, and not as a formality: path_provider is a
  platform channel, and a channel used before the binding exists throws.

  The screens themselves are not written. `frq.app` is 1,834 lines of hiccup
  over glimmer's widget tags, and glimmer is not here — Flutter brings its own
  reconciler, so those screens are a rewrite against cljd.flutter rather than a
  port. What this paints is the proof the shared half is alive under a second
  compiler: the clock and the saved session, read through exactly the
  namespaces the desktop reads them through."
  (:require ["package:flutter/material.dart" :as m]
            ["package:path_provider/path_provider.dart" :as pp]
            [cljd.flutter :as f]
            [frq.hiccup :as h]
            [frq.io.dart :as host]
            [frq.clock :as clock]
            [frq.store :as store]))

(defonce ^:private tick (atom 0))

(defn- demo
  "A hiccup tree in glimmer's tags, rendered by `frq.hiccup`.

  Hand-written, and that is the point of it for now: `frq.app`'s own screens
  cannot be required here yet — `frq.state` reaches for jolt.host through
  frq.irc and everything under it — so this exercises the tags they are built
  from until that chain is portable. Every tag here is one `frq.app` uses, and
  none of it is Flutter."
  []
  [:page {:max-width 520}
   [:title {:label "frq"}]
   [:dim-label {:label "freeq client — guest, or your Bluesky identity."}]
   [:card {}
    [:title-2 {:label "Sign in with Bluesky"}]
    [:dim-label {:label "Opens your browser for AT Protocol OAuth. freeq's broker hands back a token; no password passes through frq."}]
    [:label {:label "Handle"}]
    [:entry {:key :handle
             :placeholder "alice.bsky.social"
             :on-change (fn [_] nil)}]
    [:hbox {:spacing 8}
     [:button {:label "Connect" :primary true :on-click #(swap! tick inc)}]
     [:button {:label "Forget saved session" :destructive true :on-click #(swap! tick inc)}]]
    [:separator {}]
    [:checkbutton {:label "TLS" :active true :on-toggled (fn [_] nil)}]
    [:hbox {:spacing 6}
     [:spinner {}]
     [:dim-label {:label "Resuming your session…"}]]]
   [:card {}
    [:title-2 {:label "Shared with the desktop"}]
    [:label {:label (str "clock  " (clock/clock-time (clock/now-ms)))}]
    [:label {:label (str "store  " (if-let [s (store/load-session)]
                                     (str "signed in as " (:handle s))
                                     "no saved session"))}]
    [:dim-label {:label "Both read through frq.io, same source as jolt."}]]])

(defn ^:async main []
  (m/WidgetsFlutterBinding.ensureInitialized)
  (let [dir (.-path (await (pp/getApplicationSupportDirectory)))]
    (host/install! dir)
    (f/run
      (m/MaterialApp .title "frq"
                     .theme (m/ThemeData .useMaterial3 true
                                         .colorSchemeSeed m/Colors.indigo))
      .home
      (m/Scaffold .appBar (m/AppBar .title (m/Text "frq")))
      .body
      (f/widget :watch [_ tick])
      (m/SingleChildScrollView)
      (h/render (demo)))))
