(ns frq.main
  "The Flutter entry point: what `frq.cosmic` is to the jolt half.

  Two jobs, and the first one is why `frq.io.dart` cannot install itself the
  way `frq.io.jolt` does: the app's storage directory arrives from
  path_provider as a Future, so `main` is async, awaits it, and installs the
  host before a widget is built. Everything under ../common asks `frq.io` for
  the filesystem, so nothing shared can run until that has happened.

  `ensureInitialized` first, and not as a formality: path_provider is a
  platform channel, and a channel used before the binding exists throws.

  The screens themselves are not written. `frq.app` is 1,834 lines of hiccup
  over glimmer's widget tags, and glimmer is not here — Flutter brings its own
  reconciler, so those screens are a rewrite against cljd.flutter rather than a
  port. What this paints is the proof the shared half is alive under a second
  compiler: the clock and the saved session, read through exactly the
  namespaces the desktop reads them through."
  (:require ["package:flutter/material.dart" :as m]
            ["package:path_provider/path_provider.dart" :as pp]
            [cljd.flutter :as f]
            [frq.hiccup :as h]
            [frq.theme :as t]
            [frq.io.dart :as host]
            [frq.net.dart :as net]
            [frq.atproto.dart :as atproto]
            [frq.clock :as clock]
            [frq.store :as store]))

(defonce ^:private lines (atom []))
(defonce ^:private status (atom "not connected"))
(defonce ^:private conn (atom nil))

(def ^:private host-name "irc.freeq.at")
(def ^:private host-port 6697)

(defn- note! [m]
  ;; Bounded, because a backlog is hundreds of lines and this is a proof
  ;; rather than a message list — `frq.state/apply-msg!` is what turns these
  ;; into rooms, and it is not portable yet.
  (swap! lines (fn [v] (vec (take-last 14 (conj v m))))))

(defn ^:async connect! []
  (reset! status (str "connecting to " host-name ":" host-port " over TLS…"))
  (reset! lines [])
  (try
    (let [sock (await (net/connect!
                       {:host host-name
                        :port host-port
                        :tls? true
                        :on-msg (fn [m]
                                  (note! m)
                                  (when (= "001" (:command m))
                                    (reset! status "registered")))
                        :on-close (fn [why]
                                    (reset! status (str "closed" (when why (str ": " why)))))}))]
      (reset! conn sock)
      (reset! status "TLS up — registering")
      ;; A guest registration and nothing else. No SASL: that is frq.msgsig
      ;; and frq.atproto, neither of which is portable yet.
      (net/send-line! sock "NICK frq-phone")
      (net/send-line! sock "USER frq-phone 0 * :frq"))
    (catch Exception e
      (reset! status (str "failed: " e)))))

(defonce ^:private handle (atom "nandi-test.bsky.social"))
(defonce ^:private identity-out (atom nil))

(defn ^:async resolve-identity!
  "handle → DID → PDS, over HTTPS from the phone.

  The same three calls `frq.atproto` makes on the desktop, off the same
  `frq.atproto.core`: core says what to ask and what the answer means, and
  only who waits for it differs."
  []
  (reset! identity-out ["resolving…"])
  (try
    (let [h @handle
          did (await (atproto/resolve-handle h))
          pds (await (atproto/pds-endpoint did))]
      (reset! identity-out [(str "did  " did) (str "pds  " pds)]))
    (catch Exception e
      (reset! identity-out [(str "failed: " e)]))))

(defn- screen
  "glimmer's tags, painted by `frq.hiccup`. Nothing here is Flutter."
  []
  [:page {:max-width 560}
   [:title {:label "frq"}]
   [:dim-label {:label "TLS from dart:io, parsed by the desktop's own frq.irc.parse."}]
   [:card {}
    [:title-2 {:label "Connection"}]
    [:label {:label @status}]
    [:hbox {:spacing 8}
     [:button {:label "Connect" :primary true :on-click #(connect!)}]
     [:button {:label "Disconnect"
               :destructive true
               :on-click #(do (when-let [c @conn] (net/close! c))
                              (reset! status "closed"))}]]]
   [:card {}
    [:title-2 {:label "What the server said"}]
    (if (empty? @lines)
      [:dim-label {:label "nothing yet"}]
      (for [[i m] (map-indexed vector @lines)]
        [:vbox {:key i :spacing 0}
         [:label {:label (str (:command m)
                              (when-let [p (seq (:params m))]
                                (str "  " (last p))))}]]))]
   [:card {}
    [:title-2 {:label "Identity"}]
    [:entry {:key :handle
             :text @handle
             :placeholder "alice.bsky.social"
             :on-change #(reset! handle %)}]
    [:button {:label "Resolve" :primary true :on-click #(resolve-identity!)}]
    (when-let [out @identity-out]
      (for [[i line] (map-indexed vector out)]
        [:label {:key i :label line}]))]
   [:card {}
    [:title-2 {:label "Shared with the desktop"}]
    [:label {:label (str "clock  " (clock/clock-time (clock/now-ms)))}]
    [:label {:label (str "store  " (if-let [s (store/load-session)]
                                     (str "signed in as " (:handle s))
                                     "no saved session"))}]]])

(defn ^:async main []
  (m/WidgetsFlutterBinding.ensureInitialized)
  (let [dir (.-path (await (pp/getApplicationSupportDirectory)))]
    (host/install! dir)
    (f/run
      (m/MaterialApp .title "frq" .theme (t/app-theme))
      .home
      (m/Scaffold .appBar (m/AppBar .title (m/Text "frq")))
      .body
      ;; One f/widget with the render as its body, rather than `:watch` as a
      ;; link in the chain. A bare directive in the chain builds nothing to
      ;; rebuild, so the cells changed and the screen did not — which looks
      ;; exactly like a button that does not fire.
      (f/widget
       :watch [st status ls lines io identity-out hh handle]
       (m/SingleChildScrollView
        .child (h/render (screen)))))))
