(ns frq.pictures.web
  "Pictures in a browser: bytes from the chooser or the clipboard, and an
  XMLHttpRequest to carry them.

  No copy and no path, because there is no filesystem to copy to — that is the
  whole of the difference, and `File.copy` saying `_Namespace` is dart:io
  telling us so. The chooser hands back an `XFile` over a blob URL; what is
  useful about it is `readAsBytes`.

  And the clipboard, which the other targets have no equivalent for: a browser
  fires `paste` with the picture in it, so Ctrl-V is a way to attach one that
  costs nothing but listening."
  (:require ["dart:async" :as async]
            ["dart:html" :as html]
            ["dart:typed_data" :as td]
            ["package:image_picker/image_picker.dart" :as picker]
            [frq.pictures :as pictures]
            [frq.upload.core :as core]))

(defn- ^td/Uint8List byte-list
  "A cljd vector of byte values as the typed list Dart wants.

  Built element by element rather than handed over: what
  `frq.upload.core/request` answers with is a PersistentVector, and cljd does
  not bridge one to a `List<int>` — `frq.upload.dart` walks into a BytesBuilder
  for the same reason, and got \"PersistentVector<dynamic> is not a subtype of
  List<int>\" on screen before it did."
  [bs]
  (let [n (count bs)
        out (td/Uint8List. n)]
    (loop [s (seq bs) i 0]
      (if (nil? s)
        out
        (do (aset out i (first s))
            (recur (next s) (inc i)))))))

(defn ^:async ^:private upload! [host did channel picture]
  (let [{p :path ct :content-type body :body}
        (core/request did channel (or (:filename picture) "picture.png")
                      (vec (:bytes picture)))
        url (str "https://" host p)
        req (html/HttpRequest.)
        done (async/Completer.)]
    (.open req "POST" url)
    (.setRequestHeader req "accept" "application/json")
    (.setRequestHeader req "content-type" ct)
    (.addEventListener req "load"
                       (fn [_]
                         (when-not (.-isCompleted done)
                           (let [status (.-status req)
                                 payload (str (.-responseText req))]
                             (if (and (>= status 200) (< status 300))
                               (.complete done (core/url-of payload))
                               (.completeError
                                done
                                (Exception. (core/error-message (str status)
                                                                payload))))))
                         nil))
    (.addEventListener req "error"
                       (fn [_]
                         (when-not (.-isCompleted done)
                           (.completeError
                            done (Exception. (str "Could not reach " host))))
                         nil))
    (.send req (byte-list body))
    (await (.-future done))))

(defn ^:async ^:private pick! [_dir]
  (let [chosen (await (.pickImage (picker/ImagePicker)
                                  .source picker/ImageSource.gallery))]
    (when chosen
      (let [bytes (await (.readAsBytes chosen))]
        ;; `:path` is a name and not a place: `frq.main` keys the attachment on
        ;; it — to know whether the upload that just landed is still the
        ;; picture on screen — and `discard!` hands it to `frq.io/delete-file!`,
        ;; which on the web is a localStorage key that was never written. So it
        ;; has to be unique and it has to be harmless, and this is both.
        {:path (str "mem://" (.-millisecondsSinceEpoch (DateTime/now)) ".png")
         :bytes (vec bytes)
         :filename (or (.-name chosen) "picture.png")}))))

(defn ^:async ^:private blob-bytes
  "One clipboard file's bytes."
  [blob]
  (let [reader (html/FileReader.)
        done (async/Completer.)]
    (.addEventListener reader "loadend"
                       (fn [_]
                         (when-not (.-isCompleted done)
                           (.complete done (.-result reader)))
                         nil))
    (.readAsArrayBuffer reader blob)
    (await (.-future done))))

(defn listen-for-paste!
  "Ctrl-V, as a way to attach a picture.

  `on-picture` is called with the same map `pick!` answers with, so the paste
  and the chooser land in exactly the same place.

  A paste carrying no picture is left entirely alone — no preventDefault, no
  error — because it is somebody pasting text into the composer, which is the
  overwhelmingly common case and must keep working."
  [on-picture]
  (.addEventListener
   html/document "paste"
   (fn [e]
     (let [data (.-clipboardData e)
           files (when data (.-files data))]
       (when (and files (pos? (.-length files)))
         (let [f (.item files 0)]
           (when (.startsWith (str (.-type f)) "image/")
             (.preventDefault e)
             (.then ^async/Future (blob-bytes f)
                    (fn [buf]
                      (on-picture
                       {:path (str "mem://" (.-millisecondsSinceEpoch (DateTime/now))
                                   ".png")
                        :bytes (vec (td/Uint8List.view buf))
                        :filename (or (.-name f) "paste.png")})
                      nil))))))
     nil))
  nil)

(defn install! []
  (pictures/install! {:pick! pick!
                      :upload! upload!
                      ;; No download and no cache: the browser has both, and
                      ;; `frq.hiccup/src-url` puts the URL through the proxy so
                      ;; the bytes are allowed in. A picture is shown the
                      ;; moment its link is on screen rather than after a
                      ;; round trip this target never needed to make.
                      :preview-url identity}))
