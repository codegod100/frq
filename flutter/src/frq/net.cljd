(ns frq.net
  "What an IRC connection is, named once so both Flutter targets can answer it.

  `frq.io`'s shape, for the same reason and one floor down: a browser has no
  TCP. `frq.net.dart` opens a `SecureSocket` and cannot exist on the web;
  `frq.net.web` opens a `WebSocket` and cannot exist anywhere else, because
  `dart:html` is not a library the Android and Linux targets have. So the
  caller asks for a connection and the backend that installed itself answers.

  Flutter-only, and so under `flutter/src` rather than in `common/`: jolt has
  its own socket under `src/frq/irc`, and nothing compiled by both compilers
  calls this. `frq.io` is in `common/` because the shared screens ask it for
  the filesystem; nothing shared asks anyone for a socket.

  What a `sock` is belongs to the backend — a `Socket` on one side, a
  `WebSocket` on the other — and the caller only ever hands it back.")

(defonce ^:private impl
  ;; Keyword → fn. Empty until a backend installs, which the entry point does
  ;; beside `frq.io`'s: see `frq.main` and `frq.main-web`.
  (atom {}))

(defn install!
  "Register the transport. Called once, by the entry point, before anything
  connects."
  [m]
  (swap! impl merge m)
  nil)

(defn installed? [] (boolean (seq @impl)))

(defn ^:async connect!
  "Open a connection and start reading it.

  `on-msg` is called with a parsed map per line; `on-close` with a reason, or
  nil where the peer simply went away. Returns the socket, which `send-line!`
  and `close!` take.

  Awaited here rather than handed back as a Future for the caller to await:
  what comes out of the map is dynamic, and cljd cannot see that a dynamic
  call returns something awaitable. One `^:async` on this side gives the
  caller a Future it can see the shape of."
  [opts]
  (if-let [f (:connect! @impl)]
    (await (f opts))
    (throw (ex-info "frq.net: no transport installed" {:op :connect!}))))

(defn send-line! [sock line]
  (if-let [f (:send-line! @impl)]
    (f sock line)
    (throw (ex-info "frq.net: no transport installed" {:op :send-line!}))))

(defn close! [sock]
  (when-let [f (:close! @impl)]
    (f sock)))
