(ns frq.oauth.dart
  "The browser handoff, caught on the phone.

  The same shape as the desktop's, and for the same reason: freeq's broker owns
  the OAuth dance with the user's PDS, so a real browser has to render a real
  login page, and the only question left is how the answer gets back. It comes
  back to a loopback listener here exactly as it does on a desktop —
  `return_to` is `http://127.0.0.1:<port>` either way, and the broker is never
  told which kind of machine it is talking to.

  Two things are the phone's own. Chrome is in front of the app rather than
  beside it, so the capture page carries `frq://auth` to bring it forward —
  a scheme the manifest claims and nothing outside this device ever sees.
  And Android's cleartext ban does not apply: this is the server, and a
  browser treats `http://127.0.0.1` as a secure context.

  `dart:io` has the listener, so there is no plugin here. Opening the browser
  is the one thing Dart cannot do alone — `frq.io/open-url!` answers that."
  (:require ["dart:io" :as io]
            ["dart:async" :as async]
            ;; For `defaultTargetPlatform` alone: dart:io's `Platform` throws
            ;; in a browser, and this file compiles for the web target too.
            ;; foundation and not material, because material re-exports it
            ;; behind a `show` list that leaves the getter out.
            ["package:flutter/foundation.dart" :as fnd]
            [frq.io :as host]
            [frq.oauth.core :as core]
            [frq.oauth.handoff :as handoff]))

(defn- return-url
  "What brings the app back to the front once the browser is done, or nil where
  nothing needs to.

  On Android the browser is in front of the app and something has to raise it:
  `frq://auth` is a scheme the manifest claims, and the activity is
  `singleTask`, so it raises the app that is already running rather than
  starting a second copy of it.

  On a Linux desktop the window is already beside the browser and the reader
  switches to it, exactly as it is for `frq.oauth` under libcosmic — and
  nothing on that machine claims `frq://`, so offering the link would be a
  button that does nothing. `core/capture-html` takes nil for precisely this
  and says so; this is the caller it was written for."
  []
  (when (= fnd/TargetPlatform.android fnd/defaultTargetPlatform) "frq://auth"))

(defn ^:async await-callback!
  "Serve the loopback capture until the browser posts the handoff back.

  `on-url` is called with the login URL once the port is known — that is what
  the caller opens and shows. Returns the tokens.

  Port 0, not a walk up from 7390 as the desktop does: the desktop picks from a
  known range because its `return_to` may have to be whitelisted by hand, and
  here the broker is handed whatever the kernel gave us in the same breath."
  [broker handle on-url]
  (let [server (await (io/HttpServer.bind (.-loopbackIPv4 io/InternetAddress) 0))
        port (.-port server)
        done (async/Completer)]
    (try
      (on-url (core/login-url broker handle (str "http://127.0.0.1:" port)))
      (.listen server
               (fn [^io/HttpRequest req]
                 (let [^io/HttpResponse resp (.-response req)]
                   (if (= "POST" (.-method req))
                     ;; The fragment the page posted back. A POST carrying
                     ;; nothing usable is not the end of the wait — the real
                     ;; handoff may still arrive — so the listener stays up and
                     ;; only a good payload completes.
                     ;;
                     ;; The bytes are gathered by hand rather than run through
                     ;; `utf8.decoder`. A request is a Stream<Uint8List> and
                     ;; the decoder wants a Stream<List<int>>, which is the
                     ;; same generic ClojureDart loses through a dynamic call
                     ;; that `frq.net.dart` splits its own lines to avoid:
                     ;; the transform throws CastStream, inside a stream
                     ;; callback, where nothing catches it — so the response
                     ;; was never written and the browser sat on "Finishing
                     ;; sign-in…" for ever.
                     (let [chunks (atom [])]
                       (.listen req
                                (fn [chunk] (swap! chunks into chunk) nil)
                                .onDone
                                (fn []
                                  (let [tokens (try (core/tokens-of
                                                     (.trim ^String (host/utf8-string @chunks)))
                                                    (catch Object _ nil))]
                                    (.write resp (if tokens "ok" "bad payload"))
                                    (.then ^async/Future (.close resp)
                                           (fn [_]
                                             (when (and tokens
                                                        (not (.-isCompleted done)))
                                               (.complete done tokens))
                                             nil)))
                                  nil)))
                     (do
                       (.set (.-headers resp) "content-type"
                             "text/html; charset=utf-8")
                       (.write resp (core/capture-html (return-url)))
                       (.close resp)))
                   nil)))
      (await (.-future done))
      (finally (await (.close server .force true))))))

(defn install!
  "Register the loopback handoff. The mirror of `frq.oauth.web/install!`,
  called from `frq.main` beside the host and the transport."
  []
  (handoff/install! {:await-callback! await-callback!}))
