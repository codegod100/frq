(ns frq.theme.cosmic
  "The COSMIC theme, as it was on the machine that built this.

  GENERATED by tools/cosmic2cljd.py — `just theme`. Do not edit.

  libcosmic asks cosmic-config for these at run time, so `just cosmic run`
  follows COSMIC Settings as it changes. A phone has no cosmic-config, so
  the APK carries them instead. That is the one real difference between
  the two, and it is why this file is in git."
  (:require ["package:flutter/material.dart" :as m]))

;; Dark theme, from ~/.config/cosmic.
(def dark? true)

;; accent.base = #F4E3CFFF
(def accent (m/Color. 0xFFF4E3CF))
;; accent.on = #000000FF
(def on-accent (m/Color. 0xFF000000))
;; background.base = #202833FF
(def bg (m/Color. 0xFF202833))
;; background.component.on = #CCD1D7FF
(def on-bg (m/Color. 0xFFCCD1D7))
;; background.component.base = #343C48FF
(def component (m/Color. 0xFF343C48))
;; background.component.hover = #48505AFF
(def component-hover (m/Color. 0xFF48505A))
;; background.component.divider = #CCD1D733
(def divider (m/Color. 0x33CCD1D7))
;; primary.base = #2C3440FF
(def card (m/Color. 0xFF2C3440))
;; primary.component.base = #3B4450FF
(def card-component (m/Color. 0xFF3B4450))
;; primary.component.on = #FFFFFFFF
(def on-card (m/Color. 0xFFFFFFFF))
;; destructive.base = #FDA1A0FF
(def destructive (m/Color. 0xFFFDA1A0))
;; destructive.on = #000000FF
(def on-destructive (m/Color. 0xFF000000))
;; success.base = #92CF9CFF
(def success (m/Color. 0xFF92CF9C))

;; corner_radii
(def radius-xs 2.0)
(def radius-s 8.0)
(def radius-m 8.0)

;; spacing
(def space-xxxs 4.0)
(def space-xxs 8.0)
(def space-xs 12.0)
(def space-s 16.0)
(def space-m 24.0)
