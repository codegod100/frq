(ns frq.theme.tokens
  "The palette and the metrics, as numbers.

  These began as a read of a COSMIC theme and kept its proportions after the
  libcosmic frontend was retired — the app is painted in them directly now,
  so they are source rather than the generated file they used to be. Edit
  them here; there is no generator to re-run."
  (:require ["package:flutter/material.dart" :as m]))

;; Dark.
(def dark? true)

(def accent (m/Color. 0xFFF4E3CF))
(def on-accent (m/Color. 0xFF000000))
(def bg (m/Color. 0xFF202833))
(def on-bg (m/Color. 0xFFCCD1D7))
(def component (m/Color. 0xFF343C48))
(def component-hover (m/Color. 0xFF48505A))
(def divider (m/Color. 0x33CCD1D7))
(def card (m/Color. 0xFF2C3440))
(def card-component (m/Color. 0xFF3B4450))
(def on-card (m/Color. 0xFFFFFFFF))
(def destructive (m/Color. 0xFFFDA1A0))
(def on-destructive (m/Color. 0xFF000000))
(def success (m/Color. 0xFF92CF9C))

(def radius-xs 2.0)
(def radius-s 8.0)
(def radius-m 8.0)

(def space-xxxs 4.0)
(def space-xxs 8.0)
(def space-xs 12.0)
(def space-s 16.0)
(def space-m 24.0)
