(ns frq.media.dart
  "Images in messages, Flutter's half: spot the links, fetch them once, keep
  them on disk.

  The mirror of `frq.media` on the desktop, and the same shape — a URL goes in,
  a path on disk comes back once it is there, and never more than one fetch per
  URL however many messages carry it or however many times a row is rebuilt.
  `frq.media.core` under ../common is what the two halves agree about: which
  links are pictures, and what the file behind one is called.

  Why a file at all, when `:image` already paints an `Image.network` from a
  URL and Flutter has an image cache of its own: that cache is in memory and
  goes with the process, so every launch re-fetched every picture in the
  backlog over the phone's data. And the lightbox and the composer's
  attachment are paths rather than URLs, so a picture on disk is the shape the
  rest of the app already speaks.

  `HttpClient` and not `package:http`: it is the client `frq.atproto.dart`
  already uses, it is in the runtime, and what is wanted here is the byte
  stream rather than the string that one decodes."
  (:require ["dart:async" :as async]
            ["dart:io" :as io]
            [frq.io :as fio]
            [frq.media.core :as core]))

(defonce ^:private client (io/HttpClient.))

(defn cache-dir
  "Under the app's own storage, which is where a phone has to put this: there
  is no XDG cache directory on Android, and the directory path_provider hands
  back is the one place that is ours on both of the targets this file
  compiles for."
  []
  (str (fio/config-dir) "/media"))

(defn cached-path [url] (core/cached-path (cache-dir) url))

;; url -> :fetching | :ready | :failed
(defonce ^:private state (atom {}))

(defn path-when-ready
  "Where the picture behind `url` is, or nil while it is not there yet. The
  screens already read nil as \"not here\" and leave the link standing."
  [url]
  (when (= :ready (get @state url)) (cached-path url)))

(defn ^:async ^:private download!
  "One URL into one file. True when the file is on disk afterwards.

  Anything but a 200 is a failure with nothing written: a 404 body saved under
  the cache path is a picture that has arrived as far as the rest of this
  namespace can tell, and will never be asked for again."
  [url path]
  (try
    (let [^io/HttpClientRequest req (await (.getUrl ^io/HttpClient client
                                                    (Uri.parse (str url))))]
      (.set (.-headers req) "user-agent" "frq")
      (let [^io/HttpClientResponse resp (await (.close req))]
        (if (= 200 (.-statusCode resp))
          (let [f (io/File. path)
                sink (.openWrite f)]
            ;; Streamed into the file rather than consolidated in memory
            ;; first: a screenshot off a modern phone is several megabytes,
            ;; and there may be a screen of them.
            (await (.addStream sink resp))
            (await (.close sink))
            (.existsSync f))
          ;; Drained, or the connection is held open until the socket times
          ;; out — `HttpClient` keeps them alive and hands them back out.
          (do (await (.drain resp)) false))))
    (catch Exception _ false)))

(defn fetch!
  "Ensure the image behind `url` is on disk, in the background. Returns without
  waiting; `path-when-ready` answers for it afterwards. `on-change` is called
  when the answer changes, so the screen can repaint.

  The state map is what makes this once-only, and it is consulted before the
  disk is: a message row is rebuilt whenever anything in the conversation
  changes, and a `statSync` per picture per rebuild is a cost with no new
  answer in it."
  [url on-change]
  (when-not (contains? @state url)
    (let [path (cached-path url)]
      (if (fio/file-exists? path)
        (do (swap! state assoc url :ready) (on-change))
        (do
          (swap! state assoc url :fetching)
          (fio/mkdirs! (cache-dir))
          (.then ^async/Future (download! url path)
                 (fn [ok]
                   (swap! state assoc url (if ok :ready :failed))
                   (on-change)
                   nil)
                 .onError (fn [_ _]
                            (swap! state assoc url :failed)
                            (on-change)
                            nil)))))))
